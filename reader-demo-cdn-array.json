[
  {
    "bookSourceName": "Reader 原创公开示例 CDN",
    "bookSourceUrl": "https://cdn.jsdelivr.net/gh/Quiyyy/reader-plugin@099106c14a3f057ec18432cf306c1721418e7107/examples/online/demo/",
    "bookSourceType": 0,
    "searchUrl": "search-{{page}}.html?key={{key}}",
    "ruleSearch": {
      "bookList": ".book",
      "name": "a@text",
      "author": ".author@text",
      "bookUrl": "a@href"
    },
    "ruleBookInfo": {
      "name": "h1@text",
      "author": ".author@text",
      "intro": ".intro@text",
      "tocUrl": "a.toc@href"
    },
    "ruleToc": {
      "chapterList": ".chapters a",
      "chapterName": "@text",
      "chapterUrl": "@href",
      "nextTocUrl": "a.next@href"
    },
    "ruleContent": {
      "content": "#content@text",
      "nextContentUrl": "a.next@href"
    }
  }
]
