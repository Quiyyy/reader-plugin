{
  "bookSourceName": "Reader 原创隔离脚本验证样例",
  "bookSourceUrl": "https://cdn.jsdelivr.net/gh/Quiyyy/reader-plugin@04736393fc5b7d2f0b9d52f4774be508a159a470/examples/online/declarative/",
  "bookSourceType": 0,
  "searchUrl": "@js:java.put(\"sample\", \"original\"); \"search.html?q={{key}}&page={{page-1+1}},{'charset':'gbk'}\"",
  "ruleSearch": {
    "bookList": "#matches@tbody@tr!0",
    "name": ".title.0@text##《|》@js:result.trim()",
    "author": ".writer@text##作者：",
    "bookUrl": "a.0@href"
  },
  "ruleBookInfo": {
    "name": "//meta[@property='reader:title']/@content",
    "author": "[property$=author]@content",
    "intro": ".about@html",
    "tocUrl": "@js:java.getString(\"text.章节入口@href\")"
  },
  "ruleToc": {
    "chapterList": "class.contents@children[0]@tag.a",
    "chapterName": "text",
    "chapterUrl": "href",
    "nextTocUrl": "@css:#pages .more:not([href='#'])@href"
  },
  "ruleContent": {
    "content": "<js>if(java.get(\"sample\")!==\"original\") throw Error(\"missing sample state\"); result;</js>id.prose.0@html",
    "nextContentUrl": "//div[@class='pager']/span/a[text()='下一页']/@href",
    "replaceRegex": "##\\n?[（(]本章完[）)]$"
  },
  "concurrentRate": "2/1000",
  "header": "{'Accept':'text/html','User-Agent':'Reader-Original-Sample/1'}",
  "readerAllowedOrigins": [
    "https://raw.githubusercontent.com"
  ]
}
