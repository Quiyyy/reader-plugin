{
  "name": "reader-plugin",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite build && tsx src/server/index.ts --http",
    "build": "node scripts/build-reader.mjs",
    "start": "node dist/server/index.js",
    "preview": "node dist/server/index.js --http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build-test-host.mjs && playwright test",
    "test:books": "node scripts/test-real-books.mjs",
    "inspect:reader": "node scripts/inspect-reader.mjs",
    "upgrade:windows": "node scripts/windows-reader-upgrade.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run validate:plugin && npm run test:platform",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "lint": "node scripts/check-scripts.mjs",
    "test:platform": "node --test tests/platform/*.test.mjs",
    "prepare:local": "node scripts/prepare-local-plugin.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "package:marketplace": "node scripts/package-marketplace.mjs",
    "test:marketplace": "node --test tests/marketplace/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/apps-sdk-ui": "0.2.2",
    "@openai/mcp-extensions": "0.1.0",
    "acorn": "8.15.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "htmlparser2": "10.1.0",
    "iconv-lite": "0.7.3",
    "linkedom": "0.18.13",
    "lucide-react": "1.49.0",
    "quickjs-emscripten": "0.32.0",
    "re2js": "2.8.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "cssom": "0.5.0"
  },
  "overrides": {
    "@openai/apps-sdk-ui": {
      "lodash": "4.18.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
