{
  "bookSourceName": "Reader 原创公开示例 JSON",
  "bookSourceUrl": "https://cdn.jsdelivr.net/gh/Quiyyy/reader-plugin@a5bddf2ece1d911b2ee899b3f2b340874190fafa/demo/",
  "bookSourceType": 0,
  "searchUrl": "search-{{page}}.json?key={{key}}",
  "ruleSearch": {
    "bookList": "$.books[*]",
    "name": "$.name",
    "author": "$.author",
    "bookUrl": "$.url"
  },
  "ruleBookInfo": {
    "name": "$.name",
    "author": "$.author",
    "intro": "$.intro",
    "tocUrl": "$.tocUrl"
  },
  "ruleToc": {
    "chapterList": "$.chapters[*]",
    "chapterName": "$.name",
    "chapterUrl": "$.url",
    "nextTocUrl": "$.next"
  },
  "ruleContent": {
    "content": "$.paragraphs[*]",
    "nextContentUrl": "$.next"
  }
}
